{
  "$schema": "./_shared/schemas/site.schema.json",
  "brand": {
    "name": "MEDiml",
    "version": "0.9.0",
    "logo": "/images/brand/logo.webp",
    "logoInverse": "/images/brand/logo-white.webp",
    "logoAlt": "MEDiml logo",
    "favicon": "/images/brand/mediml-icon.webp",
    "touchIcon": "/apple-touch-icon.png"
  },
  "links": {
    "docsApp": "https://medomicslab.gitbook.io/mediml-app-docs",
    "quickStart": "https://medomicslab.gitbook.io/mediml-app-docs/quick-start",
    "docsPackage": "https://mediml.readthedocs.io/",
    "githubApp": "https://github.com/MEDomicsLab/MEDiml-app",
    "githubPackage": "https://github.com/MEDomicsLab/MEDiml",
    "issues": "https://github.com/MEDomicsLab/MEDiml-app/issues",
    "notebooks": "https://github.com/MEDomicsLab/MEDiml/tree/main/notebooks",
    "releases": "https://github.com/MEDomicsLab/MEDiml-app/releases/download/v{version}",
    "pypi": "https://pypi.org/project/MEDimage/",
    "playlist": "https://youtube.com/playlist?list=PLEPy2VhC4-D5Eg-UxRyTtmUZRh-D5m_Ru",
    "discord": "https://discord.com/invite/ZbaGj8E6mP",
    "ibsi": "https://theibsi.github.io/",
    "lab": "https://medomicslab.com/",
    "medomics": "https://medomics.app/",
    "arxiv": "https://arxiv.org/abs/2407.04888",
    "paperPdf": "https://arxiv.org/pdf/2407.04888.pdf",
    "referenceManual": "https://arxiv.org/html/2610.29666v1",
    "referenceManualPdf": "https://arxiv.org/pdf/2610.29666v1",
    "youtubeApi": "https://www.youtube.com/iframe_api",
    "youtubeEmbed": "https://www.youtube-nocookie.com/embed/",
    "softwarePaper": "https://arxiv.org/abs/2610.37715",
    "softwarePaperPdf": "https://arxiv.org/pdf/2610.37715"
  },
  "seo": {
    "siteUrl": "https://www.mediml.app",
    "siteName": "MEDiml",
    "homeTitle": "Home",
    "titleTemplate": "%s | MEDiml | Radiomics analysis",
    "description": "An all-in-one open-source software for radiomics analysis and medical image feature extraction",
    "image": {
      "src": "/images/og.png",
      "alt": "MEDiml, medical image analysis with machine learning",
      "width": 1200,
      "height": 630
    },
    "locale": "en_CA",
    "application": {
      "category": "HealthApplication",
      "operatingSystem": "Windows, macOS, Linux",
      "codeRepository": "@githubApp",
      "offer": {
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  },
  "banner": {
    "enabled": true,
    "id": "formerly-medimage",
    "text": "{name} was formerly known as **MEDimage**. Same great tool, new name!",
    "dismissible": true
  },
  "nav": {
    "items": [
      {
        "label": "Docs",
        "children": [
          {
            "label": "{name}-app",
            "href": "@docsApp",
            "text": "An all-in-one interface for medical image analysis with drag-drop style feature extraction and model training.",
            "icon": "laptop"
          },
          {
            "label": "{name}-pkg",
            "href": "@docsPackage",
            "text": "Use {name}-pkg for radiomics analysis and medical image feature extraction in Python.",
            "icon": "code"
          }
        ],
        "title": "Documentation",
        "text": "Explore the {name}-app desktop interface or the {name}-pkg Python package."
      },
      {
        "label": "Paper",
        "to": "/#paper"
      },
      {
        "label": "Features",
        "to": "/#features"
      },
      {
        "label": "Download",
        "to": "/#download"
      },
      {
        "label": "Tutorials",
        "to": "/#tutorials"
      },
      {
        "label": "IBSI",
        "href": "@ibsi"
      },
      {
        "label": "Our Lab",
        "href": "@lab"
      }
    ],
    "themeToggle": true,
    "secondary": {
      "label": "Discord",
      "href": "@discord",
      "icon": "discord"
    },
    "primary": {
      "label": "GitHub",
      "href": "@githubApp",
      "icon": "github"
    }
  },
  "footer": {
    "columns": [
      {
        "title": "Navigation",
        "source": "nav"
      },
      {
        "title": "Resources",
        "links": [
          {
            "label": "App Documentation",
            "href": "@docsApp"
          },
          {
            "label": "Code Documentation",
            "href": "@docsPackage"
          },
          {
            "label": "Video Tutorials",
            "href": "@playlist"
          }
        ]
      },
      {
        "title": "Community",
        "links": [
          {
            "label": "GitHub (Package)",
            "href": "@githubPackage"
          },
          {
            "label": "GitHub (App)",
            "href": "@githubApp"
          },
          {
            "label": "Report Issues",
            "href": "@issues"
          }
        ]
      }
    ],
    "wordmark": "{name}",
    "note": {
      "label": "Copyright © 2026 · All Right Reserved"
    },
    "credit": {
      "label": "Designed by Simon",
      "href": "https://simonprovost.xyz/"
    }
  }
}
