      {
        "label": "macOS",
        "file": ".dmg",
        "os": "mac",
        "href": "@releases/MEDiml-app-{version}-mac.dmg"
      },
      {
        "label": "Linux",
        "file": ".deb",
        "os": "linux",
        "href": "@releases/MEDiml-app-{version}-ubuntu.deb"
      }
    ],
    "links": [
      {
        "label": "Install guide",
        "href": "@quickStart"
      }
    ]
  },
  "help": {
    "title": "Troubleshooting",
    "items": [
      {
        "title": "macOS users: required step",
