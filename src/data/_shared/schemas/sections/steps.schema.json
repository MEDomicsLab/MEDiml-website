{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Steps",
  "description": "Step names with descriptions and hand-drawn connectors.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Anchor: /#id."
    },
    "title": {
      "$ref": "../common.schema.json#/definitions/text"
    },
    "text": {
      "$ref": "../common.schema.json#/definitions/text"
    },
    "align": {
      "type": "string",
      "enum": ["split", "center"]
    },
    "items": {
      "$ref": "../common.schema.json#/definitions/items"
    },
    "scrollProgress": {
      "type": "boolean",
      "default": false,
      "description": "Pin the heading and step list on desktop while scrolling selects each step, drawing and description. Small screens and reduced motion show the full static list."
    }
  },
  "required": ["title", "items"],
  "additionalProperties": false
}
