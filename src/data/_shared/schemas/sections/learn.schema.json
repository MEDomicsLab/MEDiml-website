{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Learn",
  "description": "Columns of videos, install code and tutorial links.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Anchor: /#id."
    },
    "title": {
      "$ref": "../common.schema.json#/definitions/text"
    },
    "text": {
      "$ref": "../common.schema.json#/definitions/text"
    },
    "align": {
      "type": "string",
      "enum": ["split", "center"]
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "meta": {
            "type": "string",
            "description": "Quiet note on the right of the title, e.g. Desktop application."
          },
          "text": {
            "type": "string"
          },
          "video": {
            "$ref": "../common.schema.json#/definitions/video"
          },
          "install": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "language": {
                "type": "string"
              }
            },
            "required": ["code"],
            "additionalProperties": false
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "href": {
                  "$ref": "../common.schema.json#/definitions/href"
                },
                "to": {
                  "type": "string"
                },
                "icon": {
                  "$ref": "../common.schema.json#/definitions/icon"
                }
              },
              "required": ["title"],
              "anyOf": [
                {
                  "required": ["href"]
                },
                {
                  "required": ["to"]
                }
              ],
              "additionalProperties": false
            }
          },
          "linkLabel": {
            "type": "string"
          },
          "action": {
            "$ref": "../common.schema.json#/definitions/link"
          }
        },
        "required": ["title"],
        "additionalProperties": false
      }
    }
  },
  "required": ["title", "tracks"],
  "additionalProperties": false
}
