{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Paper",
  "description": "Publications in tabs: abstract, facts and a PDF preview for each.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Anchor: /#id."
    },
    "title": {
      "$ref": "../common.schema.json#/definitions/text"
    },
    "text": {
      "$ref": "../common.schema.json#/definitions/text"
    },
    "align": {
      "type": "string",
      "enum": ["split", "center"]
    },
    "papers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/paper"
          },
          {
            "required": ["label"]
          }
        ]
      },
      "description": "Publications in tab order. The first entry is selected initially."
    },
    "paper": {
      "$ref": "#/definitions/paper"
    }
  },
  "required": ["title"],
  "oneOf": [
    {
      "required": ["papers"],
      "not": {
        "required": ["paper"]
      }
    },
    {
      "required": ["paper"],
      "not": {
        "required": ["papers"]
      }
    }
  ],
  "additionalProperties": false,
  "definitions": {
    "paper": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "authors": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        },
        "abstract": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/definitions/link"
          }
        },
        "pdf": {
          "type": "object",
          "properties": {
            "src": {
              "$ref": "../common.schema.json#/definitions/href"
            },
            "name": {
              "type": "string"
            },
            "open": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          },
          "required": ["src", "name"],
          "additionalProperties": false
        },
        "reference": {
          "type": "string",
          "description": "arXiv id, DOI or any short reference, shown before the venue."
        },
        "blocks": {
          "type": "array",
          "description": "Extra facts about the paper, each a title and its content.",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "content": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "wide": {
                "type": "boolean",
                "description": "Spans both columns, for longer content."
              }
            },
            "required": ["title", "content"],
            "additionalProperties": false
          }
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Tab title. Required for entries in papers; independent of the publication title."
        }
      },
      "required": ["title"],
      "additionalProperties": false
    }
  }
}
